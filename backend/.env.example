# ─────────────────────────────────────────────────────────────
# 菲欧娜 / Chloe 后端环境变量模板
#
# 用法:  cp backend/.env.example backend/.env   然后填入真实值
# 说明:  backend/.env 已被 .gitignore 忽略,填入的真实密钥不会进 git。
#        本文件(.env.example)只放占位,切勿在这里填真实密钥。
# 加载:  后端启动时在导入数据库等配置模块前读取 backend/.env。
#        FIONA_ENV_FILE 可指定其他 dotenv 文件；进程环境变量始终优先。
# ─────────────────────────────────────────────────────────────

# ── 必需:大模型(缺失会导致后端 import 时直接崩溃)──
# 阿里云百炼 DashScope —— 私有对话和通用能力的模型 key:
#   主力大脑 qwen3.8-omni-flash + 轻量槽 qwen3.8-flash + 联网搜索(qwen-plus) + TTS 语音合成 + 语音识别(Qwen3-ASR-Flash)。
# https://bailian.console.aliyun.com/  (API-KEY 管理)
DASHSCOPE_API_KEY=
# 模型请求默认 60 秒超时，失败最多重试 1 次；仅接受 5~300 秒、0~3 次。搜索、旅行规划、热点展开、卡片详情走原生联网接口，固定 30 秒、不重试，不受这两个变量控制。
DASHSCOPE_TIMEOUT_SECONDS=60
DASHSCOPE_MAX_RETRIES=1

# ── 可选：Claude 智能体模式 ──
# 开启条件：普通 chat、危机级别为空（high 和 possible 危机轮不进入智能体模式）、
# BYOK 已启用且 provider == "anthropic"、配置无错误、未触发 byok_unreserved；零余额保持旧路由。
# 默认 1，每轮读取，只有字面 0 关闭；非法值按开启并只告警一次。
FIONA_CLAUDE_AGENT=1
# 每轮总预算默认 240 秒，范围 60–290 秒，非法值回落默认。
# 每次请求取剩余预算与既有 BYOK 时限的较小值；每轮 4 次客户端工具、8000 字、每轮一张图。
FIONA_CLAUDE_AGENT_TOTAL_SECONDS=240
# 本轮图片和工具结果发送给 Anthropic；联网搜索/网页读取由 Anthropic 执行，计入用户额度。
# 只预扣一次 10 颗：error=false 且 stale=false 的工具卡或生图成功先累加计费项，落库成功后才结算。
# 后续失败不撤销已成立的计费；未落库的计费项退款（会话被删、保存失败、客户端断开），未存生成图清理。
# 其余全额退款；纯文字、Anthropic 联网搜索和 Claude 直接看图不扣草莓；byok_chat 在首个全局槽后计一次。
# 天气只比较本轮用户原文或最近 3 条 user 消息原文，同时使用原文和规范化文本。
# 城市候选为原样、规范化结果或去掉一个末尾行政后缀（市、省、区、县、州、盟、自治州、特别行政区）。
# 候选至少 2 个字；实际查询使用匹配到的主人原文写法，再经 normalize_city 处理，单字拒绝。
# 北京/北京市、那曲市天气/那曲可匹配；记忆、system、图片摘要和位置都不参与比较。
# 日志和 trace 不记录城市和工具参数；工具执行释放 BYOK 全局槽，整轮持有每用户锁。
# 发给 Claude 的图片副本在线程处理：长边超过 2000 像素或原始字节超过 3.5MB 时等比缩小。
# 长边不超过 2000 像素；透明 PNG 保留 PNG，其余转 JPEG、质量 85，仍超 3.5MB 则继续缩小。
# 小图原样发送，media_type 与编码一致，上传落盘文件不变。
# 生图工具失败发 image_failed 清除生成状态，把失败原因回灌 Claude 后继续；工具 done 缺图不报错，面板不变。
# 两段文字之间加两个换行并入库；工具异常只累加 agent_tool_errors，不阻断正常落库后的画像提取。
# 平台侧失败用平台文案；尚未交付文字/平台卡片/图片就请求失败时，不补发来源卡、不落库。
# 全局槽超时用「自带模型通道繁忙，请稍后再试」；预算耗尽时完成的图必须保存或清理。
# 已知局限：历史图片仅发送摘要，不发原图；镜子模式不带工具；卡片不落库，仅保留正文摘要。
# 智能体路径清除 pending，不写工具补参；服务器端工具版本、结果块类型和 usage.server_tool_use
# 字段需作者用真实 Key 核实。关闭后 Claude 回到旧原生单轮生图路径，其他厂商保持原流程。

# ── 可选：聊天图片生成 ──
# 聊天新生图流程：默认 1，只有字面 0 关闭，调用时读取；其他值按开启。
# 智能体模式之外的原生工具模式：BYOK Claude 三个型号、DeepSeek 精确
# deepseek-v4-pro / deepseek-flash；由用户模型决定画什么。
# 判断器模式：平台两槽、BYOK DashScope/Moonshot/智谱/custom、DeepSeek 其他型号。
# Kimi、智谱、自定义地址改走判断器模式，回复模型不下发工具。
# 判断器 qwen3.8-flash 读取最近 6 条对话（含本轮，历史每条最多 600 字，本轮原话最多 1500 字（超长时保留首尾）），
# 按时间顺序发送给阿里云 DashScope，保留历史「使用的描述」行。
# 本轮预筛命中、上一条回复与生图相关，或存在待补充的生图请求时，
# 多一次约 1–5 秒调用；已有生图 pending 的取消短语不调用判断器。
# 非流式 JSON/600 tokens/关闭思考，
# 在线程执行，8 秒总超时、不重试；判断器不可用时退回旧路由。
# 判断器模式下镜子模式也能生图；要画时不调用回复模型、不计 byok_chat。
FIONA_CHAT_IMAGE_TOOL=1
# 聊天工具默认 Seedream，未配置时改用 Qwen 并说明；面板仍按用户选择。
# 火山方舟密钥；留空不启用 Seedream，已配置但未开通时不换供应商重试。
ARK_API_KEY=
# Seedream 真实模型名；默认 doubao-seedream-5-0-flash-260915，调用时读取。
SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# 两种模式把根据对话撰写的描述发送给字节跳动火山引擎，描述可能包含对话内容；
# 仅原生模式由用户自选 Claude/精确 DeepSeek 决定何时生图、撰写描述。每轮最多一张图，
# 「使用的描述」写入消息正文；成功扣 10 颗、失败退款，BYOK 文字仍免费。
# 复用上方 DashScope key；需为该 key 开通对应模型权限。
# 固定每次生成一张图，150 秒总超时，不自动重试，避免重复生成和计费。
# 使用 DashScope 多模态协议；支持 qwen-image-3.0 / qwen-image-3.0-pro，
# 也可显式改为 qwen-image-2.0 / qwen-image-2.0-pro。不会自动切换模型。
# 生成图片下载到 FIONA_UPLOADS_DIR。
QWEN_IMAGE_MODEL=qwen-image-3.0

# ── 可选：为官方分身指定独立模型 ──
# 创意搭档、脚本编辑、短视频创意搭档及单人体验总结使用此配置；用户自己的分身仍使用主模型。
# provider 可选 dashscope 或 deepseek。未配置时保持 DashScope 主模型。
# 切换 DeepSeek V4 Pro：provider=deepseek，model=deepseek-v4-pro，并填写 DeepSeek key。
OFFICIAL_EXCHANGE_PROVIDER=dashscope
OFFICIAL_EXCHANGE_MODEL=
DEEPSEEK_API_KEY=

# ── 可选：我的世界热榜 ──
# 默认使用 60s 公开 API 和其文档列出的两个社区备用实例，无需 key。
# 每源缓存 5 分钟；更新失败时明确标记旧榜，最多保留 1 小时。
# 如需使用自己部署的 60s 实例，填写含 /v2 的 API 根地址；设置后不再访问公共实例。
# HOT_TOPICS_API_BASE=https://your-60s-instance.example/v2

# ── 鉴权 ──
# JWT 签名密钥。生产环境必须设为一段足够长的随机字符串,例如:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 开发模式开关。
#   =1 → 放行 X-Dev-User 头、启用 /auth/test-login、JWT 用内置默认 secret(可不填 JWT_SECRET)。
#   =0 → 生产模式,必须配置强 JWT_SECRET。
DEV_MODE=0

# ── 可选：线程池容量 ──
# 默认池保留给聊天槽位读写和流式读取；小 CPU 主机也至少配置 32 个线程。
# 慢工具/热点/卡片抓取使用独立有界池，避免挤占聊天主链路。
FIONA_DEFAULT_POOL_WORKERS=32
FIONA_SLOW_POOL_WORKERS=16

# ── 可选：草莓每日补给 ──
# 非负整数；0 表示关闭。开启后，用户登录、查询 /strawberry 或发起需计费聊天
# 时，在 Asia/Shanghai 当日首次应用补给，余额提升到至少该数值；已高于该值时不会降低。
# 管理脚本的 list 只读原始余额，不会触发补给。
# 建议值由运维按内测容量决定。管理员也可用 manage_strawberries.py 手动补充。
STRAWBERRY_DAILY_REFILL=0

# ── 可选:生产状态目录 ──
# 本地开发留空即可，默认仍使用 backend/fiona.db 和 backend/uploads/。
# 生产建议指向专用、仅服务账号可写的 /var/lib/fiona。
# FIONA_DB_PATH=/var/lib/fiona/fiona.db
# FIONA_UPLOADS_DIR=/var/lib/fiona/uploads

# 天气需在百炼控制台开通 Amap Maps，使用上方 DASHSCOPE_API_KEY。
FIONA_AMAP_ENABLED=1
FIONA_AMAP_TIMEOUT_SECONDS=8
FIONA_DAILY_WEATHER=30

# ── 可选：每用户自带聊天模型（BYOK）──
# 接管普通/镜子聊天回复，纯文字不扣草莓；Claude 默认走上述智能体模式，
# 其余原生模式决定生图，其他厂商由平台判断器决定。
# 图片由平台执行、成功扣 10 颗；明确危机回复、其他平台辅助模型和工具不变。
# 用户 Key 使用 AES-256-GCM 加密，服务端密钥必须为 url-safe base64 编码的 32 字节。
# 生成：python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 缺失/非法时 BYOK 不可用，DEV_MODE 无固定回退；单独保管，不进数据库/媒体备份。
# 丢失密钥时用户重填自己的 Key 即可。轮换时旧密钥逗号分隔，仅用于解密。
FIONA_BYOK_SECRET=
FIONA_BYOK_SECRET_PREVIOUS=
# 每人每天自带模型聊天/测试连接次数；正整数，非法回退默认并只告警一次。
FIONA_DAILY_BYOK_CHATS=200
# 本地校验失败不计次，上游连接测试计次。
FIONA_DAILY_BYOK_TESTS=20
# 专用 fiona-byok 线程池及全进程流上限；1–64，非法回退 8，调用时读取。
FIONA_BYOK_MAX_STREAMS=8
# 从建流起计时。响应头到达后，所有厂商在总时限或取消时立即中断；上游在返回响应头之前挂起时，预设厂商最多再等 60 秒读超时，custom 在 TLS 建立后立即中断；DNS 解析与 TCP/TLS 建连阶段分别最多等约 5 秒和 60 秒连接超时。
# 中断线程只标记状态并 shutdown socket，阻塞调用返回后由属主 worker 关闭流、客户端和连接池。
# 10–240 秒，非法回退 120，调用时读取；Nginx proxy_read_timeout 按两次读之间的间隔计算。
# BYOK 等待和生图期间每 10 秒有心跳；旧原生路径最坏耗时为首轮 120 秒（高档 180 秒）加生图 150 秒；
# Claude 智能体模式另受 FIONA_CLAUDE_AGENT_TOTAL_SECONDS 整轮预算限制。
# 自定义上游另有 4 MiB HTTP 响应字节上限；Claude 过载显示固定「服务繁忙，请稍后再试」。
FIONA_BYOK_TOTAL_SECONDS=120
# Claude 的接口不对中国大陆提供服务；大陆服务器通常无法连接该预设。
# 以下十一项任一非空会使 BYOK 整体不可用；请从进程环境中移除，勿在此填写：
# OPENAI_ORG_ID, OPENAI_PROJECT_ID, OPENAI_CUSTOM_HEADERS, OPENAI_BASE_URL,
# ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_PROFILE,
# ANTHROPIC_FEDERATION_RULE_ID, ANTHROPIC_IDENTITY_TOKEN, ANTHROPIC_IDENTITY_TOKEN_FILE,
# ANTHROPIC_CUSTOM_HEADERS。
# 预设厂商（含 Claude）遵循服务器的 HTTP(S)_PROXY / NO_PROXY 出站代理设置；自定义地址不使用环境代理。

# ── 本机监控（macOS 14+）──
# 数据流：本机 OCR → 只上报新增行 → 服务端判断 → 写进聊天；不扣草莓。
# 截图和整页文字留在 Mac 内存，新增文字不落日志、不写 trace，只保存提醒摘要。
# AI 规则发送新增文字给阿里云千问；选择 Claude 时发给已启用的 Anthropic BYOK。
# FIONA_LOCAL_WATCH 默认 1，设为 0 时全部 /local-watch/* 接口返回 404。
FIONA_LOCAL_WATCH=1
# FIONA_DAILY_WATCH_JUDGE 每账号每日 AI 判断次数，默认 500，开发模式与通用限流关闭也生效。
FIONA_DAILY_WATCH_JUDGE=500
# 设备令牌只显示一次，库里只存 SHA-256 哈希；本机文件权限须为 600。
# 用 umask 077 写入；已有文件另 chmod 600，不放仓库/日志/命令行，泄露后吊销。
# 已知局限：只支持 macOS；窗口最小化后截不到；OCR 可能有错字；
# 只能看到窗口当前显示的内容；Fiona 页面关闭时不会实时弹出，但提醒照样落库。
# 屏幕锁定或显示器休眠时 macOS 不允许截取窗口，期间无法监控。
# 如需离开电脑时也能监控，可在 系统设置 → 锁定屏幕 中延长自动锁定时间，但要自行权衡安全。
# 截图状态随心跳上报，后端内存保留 5 分钟；设置页逐条显示状态，不新增环境变量。
