# ─────────────────────────────────────────────────────────────
# 菲欧娜 / Chloe 后端环境变量模板
#
# 用法:  cp backend/.env.example backend/.env   然后填入真实值
# 说明:  backend/.env 已被 .gitignore 忽略,填入的真实密钥不会进 git。
#        本文件(.env.example)只放占位,切勿在这里填真实密钥。
# 加载:  后端启动时由 python-dotenv 自动读取 backend/.env(llm.py / auth.py)。
# ─────────────────────────────────────────────────────────────

# ── 必需:大模型(缺失会导致后端 import 时直接崩溃)──
# DeepSeek —— 主对话模型。https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 阿里云百炼 DashScope / 通义千问 —— 联网搜索、TTS 语音合成。
# https://bailian.console.aliyun.com/  (API-KEY 管理)
DASHSCOPE_API_KEY=

# ── 鉴权 ──
# JWT 签名密钥。生产环境必须设为一段足够长的随机字符串,例如:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 开发模式开关。
#   =1 → 放行 X-Dev-User 头、启用 /auth/test-login、JWT 用内置默认 secret(可不填 JWT_SECRET)。
#   =0 → 生产模式,必须配置强 JWT_SECRET。
DEV_MODE=0

# ── 可选:阿里云智能语音 NLS(ASR 语音识别)──
# 不填则语音识别 / 语音输入相关功能不可用,其余功能正常。
# https://ram.console.aliyun.com/manage/ak  +  NLS 控制台创建项目取 AppKey
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ASR_APPKEY=
