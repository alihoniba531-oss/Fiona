<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fiona.watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_WITH_WATCHER_EXECUTABLE</string>
        <string>run</string>
        <string>--server</string>
        <string>http://127.0.0.1:8010</string>
        <string>--token-file</string>
        <string>REPLACE_WITH_TOKEN_FILE</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <true/>
    </dict>
</dict>
</plist>
