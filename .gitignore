# ===== 前端 =====
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ===== 后端 =====
backend/__pycache__/
# 递归忽略所有子目录里的 __pycache__（覆盖 backend/tools/__pycache__/ 等）
**/__pycache__/
backend/*.pyc
backend/*.pyo
backend/.venv/
backend/venv/
backend/env/
backend/*.egg-info/
backend/dist/
backend/.pytest_cache/
backend/uploads/*
!backend/uploads/.gitkeep

# ===== 数据库（本地数据，不上传）=====
backend/*.db
# 备份文件如 fiona.db.bak-20260518-183540
backend/*.db.bak-*
backend/*.sqlite

# ===== 日志 =====
backend/err.log
backend/backend_err.txt
backend/backend_out.txt
frontend/frontend_err.txt
frontend/frontend_out.txt

# ===== 环境变量（含密钥，绝对不上传）=====
.env
.env.*
backend/.env
frontend/.env*

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

