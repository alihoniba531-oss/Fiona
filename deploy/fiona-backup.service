[Unit]
Description=Fiona online database and uploads backup

[Service]
Type=oneshot
User=fiona
Group=fiona
EnvironmentFile=/etc/fiona/fiona.env
ExecStart=/opt/fiona/deploy/fiona-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fiona /var/backups/fiona
