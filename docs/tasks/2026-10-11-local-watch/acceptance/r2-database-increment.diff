+async def authenticate_watch_device_throttled(token_hash: str) -> dict | None:
+    """Reject unknown tokens using only a read; touch valid devices once a minute.
+
+    The guarded UPDATE also checks the database timestamp, revocation and owner
+    existence. Concurrent readers of a stale timestamp cannot refresh it twice.
+    """
+    stale = """(last_seen_at IS NULL OR strftime('%s', last_seen_at) IS NULL
+        OR CAST(strftime('%s', 'now') AS INTEGER)
+             - CAST(strftime('%s', last_seen_at) AS INTEGER) >= 60)"""
+    async with aiosqlite.connect(DB_PATH, timeout=SQLITE_BUSY_TIMEOUT) as db:
+        db.row_factory = aiosqlite.Row
+        async with db.execute("""SELECT d.id,d.username,""" + stale + """ AS needs_touch
+            FROM watch_devices d JOIN users u ON u.username=d.username
+            WHERE d.token_hash=? AND d.revoked=0""", (token_hash,)) as cursor:
+            device = await cursor.fetchone()
+        if device is None:
+            return None
+        if device["needs_touch"]:
+            await db.execute("""UPDATE watch_devices SET last_seen_at=CURRENT_TIMESTAMP
+                WHERE id=? AND username=? AND token_hash=? AND revoked=0
+                AND EXISTS(SELECT 1 FROM users WHERE username=watch_devices.username)
+                AND """ + stale, (device["id"], device["username"], token_hash))
+            await db.commit()
+            # A revoke/delete may win between the read and conditional write.
+            async with db.execute("""SELECT d.id,d.username FROM watch_devices d
+                JOIN users u ON u.username=d.username
+                WHERE d.token_hash=? AND d.revoked=0""", (token_hash,)) as cursor:
+                current = await cursor.fetchone()
+            return dict(current) if current is not None else None
+        return {"id": device["id"], "username": device["username"]}
+
