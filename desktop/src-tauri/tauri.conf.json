{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "菲欧娜",
  "version": "0.1.0",
  "identifier": "com.fiona.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "菲欧娜",
