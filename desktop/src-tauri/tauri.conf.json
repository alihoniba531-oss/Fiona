{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chloe",
  "version": "0.1.0",
  "identifier": "com.fiona.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Chloe",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "capabilities": ["default", "remote-links"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:*; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "",
    "category": "SocialNetworking",
    "shortDescription": "Chloe desktop client",
    "longDescription": "Chloe — your personal AI assistant"
  }
}
