{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "菲欧娜",
  "version": "0.1.0",
  "identifier": "com.fiona.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "菲欧娜",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "",
    "category": "SocialNetworking",
    "shortDescription": "菲欧娜桌面客户端",
    "longDescription": "菲欧娜 — 你的私人 AI 助理（桌面端）",
    "resources": ["../fiona.config.example.json"]
  }
}
