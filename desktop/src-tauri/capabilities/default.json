{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认 capability — 主窗口 + 远程内容（开发者模式 localhost 动态转发端口，用户模式 madchloechat.online）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-open-url",
    "allow-open-url-in-app",
    "allow-startup-diagnostics",
    "allow-probe-backend",
    "allow-open-logs-dir"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://localhost:*/*",
      "https://madchloechat.online",
      "https://madchloechat.online/*"
    ]
  }
}
