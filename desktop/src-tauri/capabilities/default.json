{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认 capability — 主窗口 + 远程内容（webview 加载 SSH 隧道转发的 localhost:3000）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-open-url",
    "allow-open-url-in-app",
    "allow-startup-diagnostics",
    "allow-probe-backend",
    "allow-open-logs-dir"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000",
      "http://localhost:3000/*"
    ]
  }
}
